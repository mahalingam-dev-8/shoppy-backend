# Copy to .env for local development. KEY=VALUE, no quotes, no spaces around =.

PORT=3001

# JDBC form, not postgresql://user:pass@host/db as Prisma used.
DB_URL=jdbc:postgresql://localhost:5432/shoppy
DB_USERNAME=postgres
DB_PASSWORD=postgres

# At least 32 characters.
JWT_SECRET=change-me-to-a-random-string-of-32-plus-chars
JWT_EXPIRATION=1d

CORS_ORIGINS=http://localhost:3000,http://localhost:3002,https://shopping-frontend-ebon.vercel.app

STRIPE_SECRET_KEY=sk_test_xxx
# From `stripe listen` locally, or the webhook endpoint's signing secret in the Stripe dashboard.
STRIPE_WEBHOOK_SECRET=whsec_xxx
# Charge currency; matches the ₹ prices the storefront shows.
STRIPE_CURRENCY=inr

AWS_REGION=us-east-1
AWS_S3_BUCKET=your_bucket_name
# Leave empty on AWS to use the instance role.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Only for S3-compatible storage (e.g. Supabase); leave both empty for AWS S3.
# Supabase: Storage > Settings > S3 Connection gives the endpoint, region and keys.
S3_ENDPOINT=
# Supabase: https://<project-ref>.supabase.co/storage/v1/object/public/<bucket>
S3_PUBLIC_URL_BASE=

# Database connection pool size (keep small on free Postgres tiers).
DB_POOL_SIZE=5
